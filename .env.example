# Optional but strongly recommended if port 3107 is reachable from your LAN.
# Generate a long random value and send it as X-API-Key from Node-RED.
BRIDGE_API_KEY=replace-with-a-long-random-value

PORT=3000
MCP_URL=https://api.recordo.app/api/mcp/calories/mcp
OAUTH_REGISTRATION_ENDPOINT=https://api.recordo.app/api/mcp/auth/register
OAUTH_DEVICE_ENDPOINT=https://api.recordo.app/api/mcp/auth/device
OAUTH_TOKEN_ENDPOINT=https://api.recordo.app/api/mcp/auth/token
OAUTH_SCOPES=read:entries write:entries
MCP_PROTOCOL_VERSION=2025-03-26
